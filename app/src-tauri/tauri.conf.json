{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenun",
  "identifier": "cloud.tenun.desktop",
  "build": {
    "frontendDist": "../loading",
    "beforeBuildCommand": "pnpm --dir ../ui install --frozen-lockfile && pnpm --dir ../ui build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Weave your spreadsheets and databases into one dashboard.",
    "longDescription": "Tenun is a local dashboard maker. Add Excel files, CSV files and databases, draw relationships between them, and build dashboards that update when the data changes.",
    "copyright": "Tenun contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NjRCQjE3RTcwNTlGOUYKUldTZm53WG5GN3RrdG8xQnhJN3JORlcxU2puL05ka0U4MFJOUm9icHRGMUJmSVM1ZFlWTG1kdUoK",
      "endpoints": [
        "https://github.com/galohot/tenun/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
