{
  "id": "sales",
  "name": "Sales",
  "description": "What sold, where and when: totals, a trend by month, the best products.",
  "sample": "sales.csv",
  "sample_id": { "file": "penjualan.csv", "header": "tanggal,produk,kota,kuantitas,nilai" },
  "roles": [
    { "name": "date", "label": "Date", "kind": "date", "required": true,
      "description": "The day of the sale.",
      "names": ["date", "day", "orderdate", "invoicedate", "saledate", "transactiondate", "tanggal", "tgl", "waktu", "time"] },
    { "name": "amount", "label": "Amount", "kind": "number", "required": true,
      "description": "What the sale brought in.",
      "names": ["amount", "total", "sales", "revenue", "value", "turnover", "figure", "nilai", "penjualan", "omzet", "omset", "pendapatan", "nominal", "subtotal", "rupiah"] },
    { "name": "product", "label": "Product", "kind": "text", "required": true, "shape": "few",
      "description": "What was sold: a product, an item or a service.",
      "names": ["product", "item", "service", "article", "sku", "menu", "description", "produk", "barang", "namabarang", "namaproduk", "layanan", "jasa", "indicator"] },
    { "name": "quantity", "label": "Quantity", "kind": "number", "required": false,
      "description": "How many were sold.",
      "names": ["quantity", "qty", "units", "pieces", "pcs", "count", "volume", "kuantitas", "jumlah", "banyak", "unit"] },
    { "name": "region", "label": "Region", "kind": "text", "required": false, "shape": "few",
      "description": "Where it was sold: a region, a city, a store or a channel.",
      "names": ["region", "area", "city", "store", "shop", "branch", "outlet", "location", "channel", "country", "province", "wilayah", "kota", "kabupaten", "provinsi", "toko", "cabang", "lokasi", "daerah", "kanal"] }
  ],
  "dashboard": {
    "title": "Sales",
    "refresh": 0,
    "tiles": [
      { "id": "t1", "type": "kpi", "title": "", "x": 0, "y": 0, "w": 3, "h": 2,
        "measures": [{ "table": "@table", "column": "@amount", "agg": "sum" }], "dims": [] },
      { "id": "t2", "type": "kpi", "title": "", "x": 3, "y": 0, "w": 3, "h": 2,
        "measures": [{ "table": "@table", "column": null, "agg": "count" }], "dims": [] },
      { "id": "t3", "type": "kpi", "title": "", "x": 6, "y": 0, "w": 3, "h": 2,
        "measures": [{ "table": "@table", "column": "@amount", "agg": "avg" }], "dims": [] },
      { "id": "t4", "type": "kpi", "title": "", "x": 9, "y": 0, "w": 3, "h": 2,
        "measures": [{ "table": "@table", "column": "@quantity", "agg": "sum" }], "dims": [] },
      { "id": "t5", "type": "line", "title": "", "x": 0, "y": 2, "w": 8, "h": 4,
        "measures": [{ "table": "@table", "column": "@amount", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@date", "grain": "month" }] },
      { "id": "t6", "type": "share", "title": "", "x": 8, "y": 2, "w": 4, "h": 4,
        "measures": [{ "table": "@table", "column": "@amount", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@region" }] },
      { "id": "t7", "type": "bar", "title": "", "x": 0, "y": 6, "w": 6, "h": 5, "horizontal": true,
        "measures": [{ "table": "@table", "column": "@amount", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@product" }],
        "sort": { "by": "value", "desc": true }, "top": { "n": 10, "other": true } },
      { "id": "t8", "type": "bar", "title": "", "x": 6, "y": 6, "w": 6, "h": 5, "stack": "stacked",
        "measures": [{ "table": "@table", "column": "@amount", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@date", "grain": "month" }, { "table": "@table", "column": "@region" }] }
    ]
  }
}
