{
  "id": "budget",
  "name": "Budget against actual",
  "description": "What was planned and what was spent, by account, by unit and by month.",
  "sample": "budget.csv",
  "sample_id": { "file": "anggaran.csv", "header": "bulan,bagian,akun,anggaran,realisasi" },
  "roles": [
    { "name": "account", "label": "Account", "kind": "text", "required": true, "shape": "few",
      "description": "What the money is for: an account, a cost line or an activity.",
      "names": ["account", "category", "line", "costline", "item", "activity", "programme", "program", "akun", "kategori", "pos", "mataanggaran", "kegiatan", "uraian", "rekening", "belanja"] },
    { "name": "budget", "label": "Budget", "kind": "number", "required": true,
      "description": "The money planned.",
      "names": ["budget", "plan", "planned", "target", "allocation", "anggaran", "pagu", "rencana", "alokasi"] },
    { "name": "actual", "label": "Actual", "kind": "number", "required": true,
      "description": "The money spent.",
      "names": ["actual", "actuals", "spent", "spending", "expense", "expenses", "realised", "realized", "realisasi", "terpakai", "pengeluaran", "serapan"] },
    { "name": "date", "label": "Date", "kind": "date", "required": false,
      "description": "The month or day the money belongs to.",
      "names": ["date", "month", "period", "tanggal", "bulan", "periode", "tgl"] },
    { "name": "unit", "label": "Unit", "kind": "text", "required": false, "shape": "few",
      "description": "Who spends it: a department, a unit or a project.",
      "names": ["unit", "department", "dept", "division", "costcentre", "costcenter", "team", "project", "bagian", "divisi", "satker", "bidang", "seksi", "proyek"] }
  ],
  "dashboard": {
    "title": "Budget against actual",
    "refresh": 0,
    "tiles": [
      { "id": "t1", "type": "kpi", "title": "", "x": 0, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": "@budget", "agg": "sum" }], "dims": [] },
      { "id": "t2", "type": "kpi", "title": "", "x": 4, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": "@actual", "agg": "sum" }], "dims": [] },
      { "id": "t3", "type": "kpi", "title": "", "x": 8, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": "@actual", "agg": "sum",
                       "per": { "table": "@table", "column": "@budget", "agg": "sum" } }],
        "dims": [], "formats": [{ "percent": true, "decimals": 1 }] },
      { "id": "t4", "type": "bar", "title": "", "x": 0, "y": 2, "w": 7, "h": 5, "horizontal": true, "stack": "side",
        "measures": [{ "table": "@table", "column": "@budget", "agg": "sum" }, { "table": "@table", "column": "@actual", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@account" }],
        "sort": { "by": "value", "desc": true } },
      { "id": "t5", "type": "line", "title": "", "x": 7, "y": 2, "w": 5, "h": 5,
        "measures": [{ "table": "@table", "column": "@budget", "agg": "sum" }, { "table": "@table", "column": "@actual", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@date", "grain": "month" }] },
      { "id": "t6", "type": "bar", "title": "", "x": 0, "y": 7, "w": 6, "h": 5, "stack": "side",
        "measures": [{ "table": "@table", "column": "@budget", "agg": "sum" }, { "table": "@table", "column": "@actual", "agg": "sum" }],
        "dims": [{ "table": "@table", "column": "@unit" }] },
      { "id": "t7", "type": "pivot", "title": "", "x": 6, "y": 7, "w": 6, "h": 5, "totals": true,
        "measures": [{ "table": "@table", "column": "@budget", "agg": "sum" }, { "table": "@table", "column": "@actual", "agg": "sum" },
                     { "table": "@table", "column": "@actual", "agg": "sum", "per": { "table": "@table", "column": "@budget", "agg": "sum" } }],
        "dims": [{ "table": "@table", "column": "@account" }],
        "formats": [null, null, { "percent": true, "decimals": 1 }] }
    ]
  }
}
