{
  "id": "attendance",
  "name": "Attendance",
  "description": "Who came, who did not, and why: by day, by person and by unit.",
  "sample": "attendance.csv",
  "sample_id": { "file": "kehadiran.csv", "header": "tanggal,nama,bagian,kehadiran" },
  "roles": [
    { "name": "date", "label": "Date", "kind": "date", "required": true,
      "description": "The day.",
      "names": ["date", "day", "tanggal", "tgl", "hari", "waktu"] },
    { "name": "person", "label": "Person", "kind": "text", "required": true, "shape": "many",
      "description": "Who: a name or a staff number.",
      "names": ["name", "person", "employee", "staff", "student", "member", "participant", "nama", "pegawai", "karyawan", "siswa", "murid", "anggota", "peserta", "nip", "nik"] },
    { "name": "status", "label": "Status", "kind": "text", "required": true, "shape": "few",
      "description": "Present, absent, sick, on leave…",
      "names": ["status", "attendance", "presence", "present", "remark", "remarks", "keterangan", "kehadiran", "absensi", "ket", "hadir"] },
    { "name": "unit", "label": "Unit", "kind": "text", "required": false, "shape": "few",
      "description": "A department, a class or a team.",
      "names": ["unit", "department", "dept", "division", "class", "team", "group", "section", "bagian", "divisi", "kelas", "tim", "kelompok", "seksi", "bidang"] }
  ],
  "dashboard": {
    "title": "Attendance",
    "refresh": 0,
    "tiles": [
      { "id": "t1", "type": "kpi", "title": "", "x": 0, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": null, "agg": "count" }], "dims": [] },
      { "id": "t2", "type": "kpi", "title": "", "x": 4, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": "@person", "agg": "count_distinct" }], "dims": [] },
      { "id": "t3", "type": "kpi", "title": "", "x": 8, "y": 0, "w": 4, "h": 2,
        "measures": [{ "table": "@table", "column": "@date", "agg": "count_distinct" }], "dims": [] },
      { "id": "t4", "type": "donut", "title": "", "x": 0, "y": 2, "w": 4, "h": 4,
        "measures": [{ "table": "@table", "column": null, "agg": "count" }],
        "dims": [{ "table": "@table", "column": "@status" }] },
      { "id": "t5", "type": "bar", "title": "", "x": 4, "y": 2, "w": 8, "h": 4, "stack": "stacked",
        "measures": [{ "table": "@table", "column": null, "agg": "count" }],
        "dims": [{ "table": "@table", "column": "@date", "grain": "week" }, { "table": "@table", "column": "@status" }] },
      { "id": "t6", "type": "bar", "title": "", "x": 0, "y": 6, "w": 5, "h": 6, "horizontal": true, "stack": "percent",
        "measures": [{ "table": "@table", "column": null, "agg": "count" }],
        "dims": [{ "table": "@table", "column": "@unit" }, { "table": "@table", "column": "@status" }] },
      { "id": "t7", "type": "pivot", "title": "", "x": 5, "y": 6, "w": 7, "h": 6, "totals": true,
        "measures": [{ "table": "@table", "column": null, "agg": "count" }],
        "dims": [{ "table": "@table", "column": "@person" }],
        "cols": { "table": "@table", "column": "@status" } }
    ]
  }
}
