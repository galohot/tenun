{
  "name": "tenun-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "tenun.cloud", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "tenun-cloud", "database_id": "e30490d1-df9e-4343-972e-9df48fa124dd", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "tenun-snapshots" }],
  "triggers": { "crons": ["17 3 * * *"] },
  // Sign-in stays closed until the Akun keys are set as secrets and SIGNIN is switched to "open".
  // Email updates stay off until the paid Workers plan and the Email Service are set up (V5-D16, V5-D23).
  "vars": { "SIGNIN": "closed", "EMAIL_UPDATES": "off" },
  "observability": { "enabled": true }
}
